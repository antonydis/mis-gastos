{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mis-gastos",
  "main": "worker/src/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "vars": {
    "FRONTEND_URL": "https://antonydis.github.io/mis-gastos/",
    "PUBLIC_BASE_URL": "https://mis-gastos.adiazsal.workers.dev",
    "GOOGLE_CLIENT_ID": "115193157283-q79sei1assdr1ue415ho1581rlk67k3p.apps.googleusercontent.com",
    "DEFAULT_TIMEZONE": "America/Toronto",
    "OPENAI_VISION_MODEL": "gpt-6-luna",
    "OPENAI_TRANSCRIBE_MODEL": "gpt-4o-mini-transcribe"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mis-gastos",
      "database_id": "dec384c0-85c5-4e78-a81b-4c51a244070d"
    }
  ]
}
