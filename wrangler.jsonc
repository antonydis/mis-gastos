{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mis-gastos",
  "main": "worker/src/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "logs": { "invocation_logs": false }
  },
  "vars": {
    "FRONTEND_URL": "https://mis-gastos-web-28z.pages.dev/",
    "PUBLIC_BASE_URL": "https://mis-gastos.adiazsal.workers.dev",
    "GOOGLE_CLIENT_ID": "115193157283-q79sei1assdr1ue415ho1581rlk67k3p.apps.googleusercontent.com",
    "DEFAULT_TIMEZONE": "America/Toronto",
    "WAITLIST_FROM_EMAIL": "Mis Gastos <hi@antonydiaz.me>",
    "WAITLIST_NOTIFY_EMAIL": "antonyds13@gmail.com",
    "OPENAI_VISION_MODEL": "gpt-6-luna",
    "OPENAI_TRANSCRIBE_MODEL": "gpt-4o-mini-transcribe"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mis-gastos",
      "database_id": "dec384c0-85c5-4e78-a81b-4c51a244070d"
    }
  ],
  "ratelimits": [
    { "name": "PUBLIC_RATE_LIMIT", "namespace_id": "761204", "simple": { "limit": 12, "period": 60 } }
  ],
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  }
}
